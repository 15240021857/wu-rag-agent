PORT=3000
# 本机 Prisma 连 Docker 映射端口要用 127.0.0.1。localhost 会先走 ::1，Windows 上常超时。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/wu_rag?schema=public
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# 本机联调 agent-server；docker compose 内使用 http://agent-server:8001
RAG_BASE_URL=http://127.0.0.1:8001

