# 复制为仓库根目录 .env 后按环境修改。docker compose 会自动读取 .env。
# 只把 postgres 跑在容器里、Nest 跑在本机时，server/.env 的 DATABASE_URL 仍用 localhost。

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wu_rag
POSTGRES_PORT=5432

SERVER_PORT=3000
WEB_PORT=8080

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# agent-server 宿主机映射端口（容器内固定 8001）
RAG_PORT=8001
# 本机直接跑 Nest 时指向本机 agent-server；compose 内会覆盖为 http://agent-server:8001
RAG_BASE_URL=http://127.0.0.1:8001

# agent-server 首次入库或检索时才连接，默认 http://localhost:19530
# MILVUS_URI=http://localhost:19530

DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# UV_INDEX_URL：不是 Python 解释器/虚拟环境本身。
# 它是 uv（agent-server 的包管理器）拉 Python 依赖时用的 PyPI 源地址。
# 国内默认官网慢/超时，可换成阿里云镜像；只影响 docker 构建 agent-server 时装包速度。
# UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
